---
import Base from '../layouts/Base.astro';
import site from '../config/site.json';
import { getPublishedWorks } from '../lib/works';
import { KINDS, kindLabel } from '../lib/kinds';
import { STATUSES, statusKey } from '../lib/statuses';
import { statusLabelHtml, tagListHtml } from '../lib/parts';
import { formatDate } from '../lib/render';
import { withBase, workUrl } from '../lib/paths';

const works = await getPublishedWorks();
const tags = [...new Set(works.flatMap((w) => w.data.tags))].sort((a, b) => a.localeCompare(b, 'ja'));
const usedKinds = KINDS.filter((k) => works.some((w) => w.data.kind === k.id));
---
<Base>
  <div class="home">
    <p class="home-lead">{site.description}</p>

    <form class="finder" role="search" data-finder onsubmit="return false">
      <div class="search-box">
        <label for="q">検索</label>
        <input id="q" name="q" type="search" placeholder="ことばで探す" autocomplete="off" enterkeyhint="search" />
      </div>

      <fieldset class="chips">
        <legend>状態</legend>
        <label class="chip"><input type="radio" name="status" value="" checked /><span>すべて</span></label>
        {STATUSES.map((s) => (
          <label class="chip"><input type="radio" name="status" value={s.value} /><span>{s.value}</span></label>
        ))}
      </fieldset>

      {usedKinds.length > 1 && (
        <fieldset class="chips">
          <legend>種類</legend>
          <label class="chip"><input type="radio" name="kind" value="" checked /><span>すべて</span></label>
          {usedKinds.map((k) => (
            <label class="chip"><input type="radio" name="kind" value={k.id} /><span>{k.label}</span></label>
          ))}
        </fieldset>
      )}

      {tags.length > 0 && (
        <fieldset class="chips">
          <legend>タグ</legend>
          <label class="chip"><input type="radio" name="tag" value="" checked /><span>すべて</span></label>
          {tags.map((t) => (
            <label class="chip"><input type="radio" name="tag" value={t} /><span>#{t}</span></label>
          ))}
        </fieldset>
      )}
      <p class="search-note" data-search-note hidden></p>
    </form>

    <p class="result-count" aria-live="polite" data-count>{works.length}件</p>

    <ul class="work-list" data-list>
      {works.map((w) => {
        const d = w.data;
        const url = workUrl(w.id);
        return (
          <li class="work-card" data-url={url} data-status={d.status} data-kind={d.kind} data-tags={JSON.stringify(d.tags)}>
            <a class="thumb" href={url} tabindex="-1" aria-hidden="true">
              {d.thumbnail ? (
                <img src={withBase(d.thumbnail)} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class:list={['thumb', 'thumb-fallback', `status-${statusKey(d.status)}`]}>{kindLabel(d.kind)}</span>
              )}
            </a>
            <div class="card-body">
              <h2 class="card-title"><a href={url}>{d.title}</a></h2>
              {d.summary && <p class="card-summary">{d.summary}</p>}
              <div class="card-meta">
                <Fragment set:html={statusLabelHtml(d.status)} />
                <span class="kind">{kindLabel(d.kind)}</span>
                <span class="date">最終更新 <time datetime={formatDate(d.updated)}>{formatDate(d.updated)}</time></span>
              </div>
              <Fragment set:html={tagListHtml(d.tags)} />
              <p class="search-excerpt" data-excerpt hidden></p>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="empty" data-empty hidden>当てはまる作品がありません。</p>
    {works.length === 0 && <p class="empty">まだ作品がありません。</p>}
  </div>
</Base>

<script>
  import { initFinder } from '../scripts/finder';
  initFinder();
</script>
