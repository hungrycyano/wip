---
import Base from '../../layouts/Base.astro';
import ReaderSettings from '../../components/ReaderSettings.astro';
import { getPublishedWorks, type Work } from '../../lib/works';
import { articleHtml, bodyChars, metaHtml } from '../../lib/parts';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const d = work.data;
const body = work.body ?? '';
const chars = bodyChars(d, body);
const bgStyle = d.background ? `background-image: url("${withBase(d.background)}")` : undefined;
---
<Base title={d.title} description={d.summary}>
  <div class:list={['work-page', { 'has-bg': d.background }]} style={bgStyle}>
    <div class="reader-tools">
      <ReaderSettings />
    </div>

    {d.audio && (
      <div class="work-audio">
        <audio controls preload="none" src={withBase(d.audio)}>
          お使いのブラウザでは音声を再生できません。
        </audio>
      </div>
    )}

    <div class="reader">
      <div class="reader-scroll" data-reader-scroll>
        <article class="work" data-pagefind-body data-pagefind-meta={`title:${d.title}`} set:html={articleHtml(d, body)} />
      </div>
      <div class="pos" data-pos hidden>
        <label for="pos-range" class="visually-hidden">読んでいる位置</label>
        <input id="pos-range" type="range" min="0" max="1000" step="10" value="0" />
        <span class="pos-bar" aria-hidden="true"><span></span></span>
        <output for="pos-range" aria-hidden="true">0%</output>
      </div>
    </div>

    <aside class="work-meta" aria-label="作品の情報" set:html={metaHtml(d, chars)} />

    <p class="back"><a href={withBase('/')}>← 一覧へ戻る</a></p>
  </div>
</Base>

<script>
  import { initPosition } from '../../scripts/position';
  const scroller = document.querySelector<HTMLElement>('[data-reader-scroll]');
  const box = document.querySelector<HTMLElement>('[data-pos]');
  if (scroller && box) initPosition(scroller, box);
</script>
