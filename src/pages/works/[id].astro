---
import Base from '../../layouts/Base.astro';
import WorkReader from '../../components/WorkReader.astro';
import { chapterSlug, getChapters, getPublishedWorks, isFolderWork, type Work } from '../../lib/works';
import { articleHtml, bodyChars, metaHtml, tocHtml } from '../../lib/parts';
import { workUrl } from '../../lib/paths';

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const d = work.data;
const body = work.body ?? '';
// 章分けした長編なら、本文は「まえがき」として扱い、下に目次を出す
const chapters = isFolderWork(work) ? await getChapters(work.id) : [];
const toc = chapters.map((c) => ({
  url: `${workUrl(work.id)}${chapterSlug(c)}/`,
  title: c.data.title,
  chars: bodyChars(d, c.body ?? ''),
}));
const chars = bodyChars(d, body) + toc.reduce((n, t) => n + t.chars, 0);
---
<Base title={d.title} description={d.summary}>
  <WorkReader article={articleHtml(d, body)} searchTitle={d.title} background={d.background} audio={d.audio} editId={work.id}>
    {toc.length > 0 && (
      <div class="toc-wrap">
        <Fragment set:html={tocHtml(toc)} />
        <p class="toc-start"><a href={toc[0].url}>最初から読む →</a></p>
      </div>
    )}
    <aside class="work-meta" aria-label="作品の情報" set:html={metaHtml(d, chars, { chapters: chapters.length })} />
  </WorkReader>
</Base>
